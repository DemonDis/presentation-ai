# ===========================================
# БАЗА ДАННЫХ
# ===========================================
# Строка подключения PostgreSQL
# Формат: postgresql://пользователь:пароль@хост:порт/база_данных
# При использовании Docker: postgresql://postgres:postgres@localhost:5432/presentation_ai
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/presentation_ai"

# ===========================================
# NEXTAUTH (Аутентификация)
# ===========================================
# Секретный ключ для сессий NextAuth.js
# Сгенерируйте командой: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Базовый URL приложения
# Разработка: http://localhost:3000
# Продакшн: https://ваш-домен.ru
NEXTAUTH_URL="http://localhost:3000"

# ===========================================
# Настройки AI API
# ===========================================
# API ключ для LLM провайдера (OpenAI-совместимый API)
OPENAI_API_KEY="sk-"

# Базовый URL для конечной точки API
OPENAI_API_BASE=""

# Имя модели для использования (опционально, можно выбрать в интерфейсе)
# Доступная модель:
OPENAI_MODEL="Qwen"

# ===========================================
# REMOTE API (chat.ehd-zr.cbr.ru)
# ===========================================
# API ключ для remote endpoint
REMOTE_API_KEY=""

# ===========================================
# TOGETHER AI (Опционально)
# ===========================================
# Получите API ключ: https://together.ai
TOGETHER_AI_API_KEY=""

# ===========================================
# UPLOADTHING (Сервис загрузки файлов)
# ===========================================
# Получите токен: https://uploadthing.com
UPLOADTHING_TOKEN=""

# ===========================================
# UNSPLASH (Сервис изображений - Опционально)
# ===========================================
# Получите ключ доступа: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=""

# ===========================================
# TAVILY (Поисковый API - Опционально)
# ===========================================
# Получите API ключ: https://tavily.com
TAVILY_API_KEY=""

# ===========================================
# GOOGLE Custom Search API (Опционально)
# ===========================================
GOOGLE_CUSTOM_SEARCH_API_KEY=""
SEARCH_ENGINE_CX=""

# ===========================================
# FAL AI (Опционально)
# ===========================================
# Получите API ключ: https://fal.ai
FAL_API_KEY=""

# ===========================================
# PINECONE (Векторная база данных - Опционально)
# ===========================================
# Получите API ключ: https://pinecone.io
PINECONE_API_KEY=""